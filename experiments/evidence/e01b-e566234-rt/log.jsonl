{"seq": 56, "dir": "rx", "t_mono_ns": 1239540209866, "stream_ms": 110001.47, "msg": {"type": "pong", "id": 23}}
{"seq": 57, "dir": "tx", "t_mono_ns": 1241999977521, "stream_ms": 112460, "msg": {"type": "agent_utterance_end", "utt_id": "A0", "stream_ms": 112450}}
