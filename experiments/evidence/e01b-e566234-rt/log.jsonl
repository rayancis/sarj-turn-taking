{"seq": 45, "dir": "rx", "t_mono_ns": 1214541497718, "stream_ms": 85002.78, "msg": {"type": "pong", "id": 18}}
{"seq": 46, "dir": "tx", "t_mono_ns": 1216479569474, "stream_ms": 86940, "msg": {"type": "agent_utterance_end", "utt_id": "A0", "stream_ms": 86940}}
